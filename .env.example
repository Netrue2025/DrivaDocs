# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Database: use PostgreSQL in production. SQLite is handy for a quick local spike.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/drivadocs?schema=public"
# For Supabase/pooled Postgres, use DATABASE_URL for runtime and DIRECT_URL for migrations/schema pushes.
# Example transaction pooler runtime connection:
# DATABASE_URL="postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=1"
# Example session/direct connection:
# DATABASE_URL="postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=1&pool_timeout=20"
# DIRECT_URL="postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/drivadocs?schema=public"

# Paystack
PAYSTACK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=replace-with-paystack-webhook-secret

# Upload storage, ready for Supabase/S3/local adapter
UPLOAD_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=drivadocs-uploads

# Notifications
EMAIL_FROM="DRIVADocs <support@drivadocs.ng>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_BUSINESS_PHONE=2348000000000
PUBLIC_SUPPORT_PHONE=2348000000000
